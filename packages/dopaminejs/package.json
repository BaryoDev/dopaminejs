{
    "name": "dopaminejs",
    "version": "3.2.0",
    "description": "Progression mechanics for web apps: XP, levels, achievements and timezone-correct daily streaks, with the particles and sound to make them land. Zero dependencies.",
    "type": "module",
    "main": "./dist/dopamine.cjs",
    "module": "./dist/dopamine.js",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/dopamine.js",
            "require": "./dist/dopamine.cjs"
        },
        "./core": {
            "types": "./types/core.d.ts",
            "import": "./dist/core.js",
            "require": "./dist/core.cjs"
        },
        "./games": {
            "types": "./types/games.d.ts",
            "import": "./dist/games.js",
            "require": "./dist/games.cjs"
        },
        "./testing": {
            "types": "./types/testing.d.ts",
            "import": "./dist/testing.js",
            "require": "./dist/testing.cjs"
        },
        "./style.css": "./dist/style.css",
        "./spec/*": "./spec/*"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "spec",
        "src",
        "types"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "preview": "vite preview"
    },
    "keywords": [
        "gamification",
        "progression",
        "streaks",
        "daily-streak",
        "xp",
        "levels",
        "achievements",
        "engagement",
        "rewards",
        "user-retention",
        "juice",
        "particles",
        "confetti",
        "feedback"
    ],
    "author": "BaryoDev",
    "license": "MPL-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/BaryoDev/dopaminejs.git",
        "directory": "packages/dopaminejs"
    },
    "bugs": {
        "url": "https://github.com/BaryoDev/dopaminejs/issues"
    },
    "homepage": "https://github.com/BaryoDev/dopaminejs#readme",
    "types": "./types/index.d.ts",
    "engines": {
        "node": ">=20.19"
    },
    "peerDependencies": {
        "vitest": ">=2.0.0"
    },
    "peerDependenciesMeta": {
        "vitest": {
            "optional": true
        }
    }
}
