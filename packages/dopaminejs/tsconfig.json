{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": false,
        "exactOptionalPropertyTypes": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "types/**/*.ts",
        "type-tests/**/*.ts"
    ]
}
