{
    "name": "dopaminejs-react",
    "version": "1.0.0",
    "description": "React bindings for DopamineJS — useRewards() hook and RewardsProvider for XP, levels, achievements, and daily streaks",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "vite build"
    },
    "keywords": [
        "dopaminejs",
        "react",
        "hook",
        "gamification",
        "xp",
        "levels",
        "achievements",
        "streaks",
        "rewards"
    ],
    "author": "BaryoDev",
    "license": "MIT",
    "engines": {
        "node": ">=20.19"
    },
    "peerDependencies": {
        "dopaminejs": "^2.0.0",
        "react": ">=18.0.0"
    },
    "devDependencies": {
        "vite": "^5.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/BaryoDev/dopaminejs.git",
        "directory": "packages/dopaminejs-react"
    },
    "bugs": {
        "url": "https://github.com/BaryoDev/dopaminejs/issues"
    },
    "homepage": "https://github.com/BaryoDev/dopaminejs#readme"
}
