{
    "suite": "migrate",
    "description": "Loading saved state. Storage is untrusted, so every field is checked on load. A document with no v is a 2.x save and moves under the device key legacy.",
    "cases": [
        {
            "name": "corrupt json falls back to a default player",
            "clock": "2026-08-07T09:00:00",
            "savedRaw": "{not json",
            "afterInit": {
                "player": {
                    "name": "Player",
                    "xp": 0,
                    "level": 1,
                    "totalGamesPlayed": 0,
                    "streak": {
                        "current": 0,
                        "longest": 0
                    }
                },
                "absent": [
                    "streak.lastPlayDate"
                ],
                "playerExact": {
                    "stats": {},
                    "achievements": {}
                },
                "events": [
                    {
                        "event": "load_failed",
                        "reason": "corrupt"
                    }
                ]
            },
            "note": "The default player has no play dates, so the streak is 0 and has no last play date."
        },
        {
            "name": "a numeric string xp is read as a number",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "xp": "250"
            },
            "note": "A string that holds a finite number is coerced in every field that expects a number, so the player keeps the progress.",
            "afterInit": {
                "player": {
                    "xp": 250,
                    "level": 2
                },
                "events": []
            }
        },
        {
            "name": "blank and non-finite strings fall back to the default",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "xp": "  ",
                "totalGamesPlayed": "Infinity",
                "level": "",
                "name": "Sam"
            },
            "note": "An empty or blank string is not 0, and Infinity is not finite, so both fall back.",
            "afterInit": {
                "player": {
                    "xp": 0,
                    "level": 1,
                    "totalGamesPlayed": 0,
                    "name": "Sam"
                },
                "events": []
            }
        },
        {
            "name": "non-numeric xp becomes 0",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "xp": "abc"
            },
            "afterInit": {
                "player": {
                    "xp": 0,
                    "level": 1
                },
                "events": []
            }
        },
        {
            "name": "negative numbers fall back to defaults",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "xp": -50,
                "level": -3,
                "totalGamesPlayed": -4,
                "streak": {
                    "current": -2,
                    "longest": -9,
                    "lastPlayDate": "2026-08-07"
                }
            },
            "afterInit": {
                "player": {
                    "xp": 0,
                    "level": 1,
                    "totalGamesPlayed": 0,
                    "streak": {
                        "current": 1,
                        "longest": 1,
                        "lastPlayDate": "2026-08-07"
                    }
                },
                "events": []
            }
        },
        {
            "name": "2.x level above the curve is kept",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "xp": 0,
                "level": 7
            },
            "note": "Older versions banked levels at half the XP. Those players keep the level; progress to the next level starts at 0.",
            "afterInit": {
                "player": {
                    "xp": 0,
                    "level": 7
                },
                "events": []
            },
            "steps": [
                {
                    "op": "getXPForNextLevel",
                    "expect": {
                        "returns": {
                            "total": 2800,
                            "needed": 2800,
                            "progress": 0
                        }
                    }
                }
            ]
        },
        {
            "name": "level below the curve is raised",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "xp": 1000,
                "level": 2
            },
            "afterInit": {
                "player": {
                    "xp": 1000,
                    "level": 5
                },
                "events": []
            }
        },
        {
            "name": "2.x streak current of 0 with a date migrates to one play date",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "streak": {
                    "current": 0,
                    "longest": 3,
                    "lastPlayDate": "2026-08-07"
                }
            },
            "afterInit": {
                "player": {
                    "streak": {
                        "current": 1,
                        "longest": 3,
                        "lastPlayDate": "2026-08-07"
                    }
                },
                "doc": {
                    "playDates": [
                        "2026-08-07"
                    ]
                },
                "events": []
            },
            "note": "Intended. A streak of 0 with a real date still counts that date as one play day, so no play is lost. The same day gives 1 and the next day gives 2.",
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "expect": {
                        "player": {
                            "streak": {
                                "current": 1,
                                "longest": 3
                            }
                        }
                    }
                },
                {
                    "op": "setClock",
                    "at": "2026-08-08T09:00:00"
                },
                {
                    "op": "record",
                    "activity": "g",
                    "expect": {
                        "player": {
                            "streak": {
                                "current": 2,
                                "longest": 3
                            }
                        }
                    }
                }
            ]
        },
        {
            "name": "streak longest below current is raised",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "streak": {
                    "current": 4,
                    "longest": 2,
                    "lastPlayDate": "2026-08-07"
                }
            },
            "afterInit": {
                "player": {
                    "streak": {
                        "current": 4,
                        "longest": 4,
                        "lastPlayDate": "2026-08-07"
                    }
                },
                "events": []
            }
        },
        {
            "name": "a lastPlayDate that is not a real calendar day is dropped",
            "clock": "2026-08-07T09:00:00",
            "note": "9999-99-99 has the date shape but is no day, so it counts as no date. The play dates are empty and longest stays.",
            "savedJson": {
                "streak": {
                    "current": 5,
                    "longest": 5,
                    "lastPlayDate": "9999-99-99"
                }
            },
            "afterInit": {
                "player": {
                    "streak": {
                        "current": 0,
                        "longest": 5
                    }
                },
                "absent": [
                    "streak.lastPlayDate"
                ],
                "doc": {
                    "playDates": []
                },
                "events": []
            }
        },
        {
            "name": "an invalid lastPlayDate keeps the best run and the next play starts the date",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "streak": {
                    "current": 7,
                    "longest": 3,
                    "lastPlayDate": "2026-13-45"
                }
            },
            "note": "The count is not thrown away: the larger of current and longest stays as longest. With no date there is no current run, so the next record starts it at 1.",
            "afterInit": {
                "player": {
                    "streak": {
                        "current": 0,
                        "longest": 7
                    }
                },
                "absent": [
                    "streak.lastPlayDate"
                ],
                "doc": {
                    "playDates": []
                },
                "events": []
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "expect": {
                        "player": {
                            "streak": {
                                "current": 1,
                                "longest": 7,
                                "lastPlayDate": "2026-08-07"
                            }
                        },
                        "doc": {
                            "playDates": [
                                "2026-08-07"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "a February 30th lastPlayDate is dropped",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "streak": {
                    "current": 3,
                    "longest": 3,
                    "lastPlayDate": "2026-02-30"
                }
            },
            "afterInit": {
                "player": {
                    "streak": {
                        "current": 0,
                        "longest": 3
                    }
                },
                "absent": [
                    "streak.lastPlayDate"
                ],
                "events": []
            }
        },
        {
            "name": "hostile stats keys and values are dropped",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "stats": {
                    "__proto__": {
                        "totalPlays": 5
                    },
                    "constructor": {
                        "x": 1
                    },
                    "prototype": {},
                    "good": {
                        "totalPlays": "3",
                        "highScore": 12,
                        "kills": 4,
                        "bad": "x",
                        "__proto__": 9,
                        "nothing": null
                    },
                    "arr": [
                        1
                    ],
                    "str": "x"
                }
            },
            "note": "totalPlays \"3\" holds a number, so it is read as 3. \"x\" is not a number and is dropped. Unsafe keys never reach the document.",
            "afterInit": {
                "playerExact": {
                    "stats": {
                        "good": {
                            "plays": 3,
                            "best": 12,
                            "kills": 4
                        }
                    }
                },
                "events": []
            }
        },
        {
            "name": "bad stat numbers are repaired and missing fields added",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "stats": {
                    "g": {
                        "totalPlays": -2,
                        "highScore": "99",
                        "x": 1.5
                    },
                    "h": {
                        "wins": 2
                    }
                }
            },
            "afterInit": {
                "playerExact": {
                    "stats": {
                        "g": {
                            "plays": 0,
                            "best": 99,
                            "x": 1.5
                        },
                        "h": {
                            "wins": 2,
                            "plays": 0,
                            "best": 0
                        }
                    }
                },
                "events": []
            },
            "note": "highScore \"99\" is read as 99. totalPlays -2 is negative and falls back to 0."
        },
        {
            "name": "hostile achievement entries are dropped",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "achievements": {
                    "__proto__": {
                        "unlockedAt": 1,
                        "seen": true
                    },
                    "constructor": {
                        "unlockedAt": 1
                    },
                    "first_game": {
                        "unlockedAt": "x",
                        "seen": "true"
                    },
                    "level_5": {
                        "unlockedAt": 123,
                        "seen": true
                    },
                    "unknown_id": {
                        "seen": true
                    },
                    "bad": 5,
                    "arr": []
                }
            },
            "note": "Ids are not checked against the defined achievements. Entries that are not objects are dropped. seen is true only for the boolean true. Each unlocked achievement brings its stored reward, so the XP is 50 + 100 here.",
            "afterInit": {
                "player": {
                    "achievements": {
                        "first_game": {
                            "seen": false
                        },
                        "level_5": {
                            "unlockedAt": 123,
                            "seen": true
                        },
                        "unknown_id": {
                            "seen": true
                        }
                    },
                    "xp": 150,
                    "level": 2
                },
                "achievements": [
                    "first_game",
                    "level_5",
                    "unknown_id"
                ],
                "absent": [
                    "achievements.__proto__",
                    "achievements.constructor",
                    "achievements.bad",
                    "achievements.arr"
                ],
                "events": []
            }
        },
        {
            "name": "unknown top level fields in a 2.x save are kept",
            "clock": "2026-08-07T09:00:00",
            "note": "Intended. A newer version or a mod wrote them, so dropping them would lose data. They stay in the saved document and never reach the player view.",
            "savedJson": {
                "xp": 30,
                "custom": {
                    "a": 1
                },
                "flags": [
                    1,
                    2
                ]
            },
            "afterInit": {
                "player": {
                    "xp": 30
                },
                "absent": [
                    "custom",
                    "flags"
                ],
                "doc": {
                    "custom": {
                        "a": 1
                    },
                    "flags": [
                        1,
                        2
                    ]
                },
                "events": []
            }
        },
        {
            "name": "unknown top level fields in a version 3 save survive a save and a reload",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "v": 3,
                "xpBy": {
                    "a": 10
                },
                "from_newer": {
                    "theme": "dark",
                    "list": [
                        1,
                        {
                            "x": 2
                        }
                    ]
                },
                "extra_flag": true
            },
            "note": "Intended. The fields come back after the core writes and a new page load reads.",
            "afterInit": {
                "doc": {
                    "from_newer": {
                        "theme": "dark",
                        "list": [
                            1,
                            {
                                "x": 2
                            }
                        ]
                    },
                    "extra_flag": true
                },
                "events": []
            },
            "steps": [
                {
                    "op": "addXP",
                    "amount": 5,
                    "expect": {
                        "player": {
                            "xp": 15
                        },
                        "doc": {
                            "from_newer": {
                                "theme": "dark"
                            },
                            "extra_flag": true
                        }
                    }
                },
                {
                    "op": "reload",
                    "expect": {
                        "player": {
                            "xp": 15
                        },
                        "doc": {
                            "from_newer": {
                                "theme": "dark",
                                "list": [
                                    1,
                                    {
                                        "x": 2
                                    }
                                ]
                            },
                            "extra_flag": true
                        }
                    }
                }
            ]
        },
        {
            "name": "unsafe top level keys are dropped on load and stay gone after a save",
            "clock": "2026-08-07T09:00:00",
            "savedJson": {
                "v": 3,
                "xpBy": {
                    "a": 10
                },
                "__proto__": {
                    "polluted": true
                },
                "constructor": {
                    "x": 1
                },
                "prototype": {
                    "y": 2
                },
                "kept": {
                    "__proto__": {
                        "z": 1
                    },
                    "ok": 2
                }
            },
            "note": "Never copied onto a plain object, at the top or inside a kept value. The ordinary field next to them stays.",
            "afterInit": {
                "player": {
                    "xp": 10
                },
                "docAbsent": [
                    "__proto__",
                    "constructor",
                    "prototype"
                ],
                "docExact": {
                    "kept": {
                        "ok": 2
                    }
                },
                "events": []
            },
            "steps": [
                {
                    "op": "addXP",
                    "amount": 5,
                    "expect": {
                        "player": {
                            "xp": 15
                        },
                        "docAbsent": [
                            "__proto__",
                            "constructor",
                            "prototype"
                        ]
                    }
                },
                {
                    "op": "reload",
                    "expect": {
                        "player": {
                            "xp": 15
                        },
                        "docAbsent": [
                            "__proto__",
                            "constructor",
                            "prototype"
                        ],
                        "docExact": {
                            "kept": {
                                "ok": 2
                            }
                        }
                    }
                }
            ]
        },
