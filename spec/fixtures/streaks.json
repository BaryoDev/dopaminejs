                        },
                        "events": [
                            {
                                "event": "streak_updated",
                                "current": 4,
                                "longest": 4
                            },
                            {
                                "event": "xp_gained",
                                "amount": 12,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 44
                            }
                        ]
                    }
                },
                {
                    "op": "setClock",
                    "at": "2026-08-05T09:00:00"
