                },
                {
                    "op": "setClock",
                    "at": "2026-08-04T09:00:00"
                },
                {
                    "op": "recordGame",
                    "game": "g",
                    "expect": {
                        "player": {
                            "xp": 44,
                            "level": 1,
                            "streak": {
                                "current": 4,
                                "longest": 4
