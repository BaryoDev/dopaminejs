{
    "name": "dopaminejs-monorepo",
    "version": "3.2.0",
    "private": true,
    "type": "module",
    "description": "DopamineJS monorepo - Game Feel Engine for the web",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "test": "node scripts/run-tests.js",
        "test:watch": "npm run test:watch --workspace=dopaminejs",
        "test:ci": "node scripts/run-tests.js",
        "dev": "npm run dev --workspace=dopaminejs",
        "clean": "rm -rf packages/*/dist packages/*/node_modules",
        "typecheck": "tsc -p packages/dopaminejs/tsconfig.json",
        "size": "size-limit",
        "check-zero-deps": "node scripts/check-zero-deps.js",
        "verify": "npm run typecheck && npm run test:ci && DOPAMINE_TEST_TZ=America/Los_Angeles npm run test:ci -- conformance && node scripts/check-versions.js && npm run check-zero-deps && npm run build && node scripts/check-versions.js --dist && node scripts/check-core-import.js && npm run size"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/BaryoDev/dopaminejs.git"
    },
    "keywords": [
        "game",
        "gamedev",
        "game-feel",
        "juice",
        "feedback",
        "rewards"
    ],
    "author": "BaryoDev",
    "license": "MPL-2.0",
    "devDependencies": {
        "@size-limit/preset-small-lib": "^12.1.0",
        "jsdom": "^28.1.0",
        "size-limit": "^12.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^4.1.11",
        "vue": "^3.5.44"
    },
    "size-limit": [
        {
            "path": "packages/dopaminejs/dist/dopamine.js",
            "import": "*",
            "limit": "15 KB",
            "name": "dopaminejs (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/dopamine.cjs",
            "limit": "15 KB",
            "name": "dopaminejs (CJS)"
        },
        {
            "path": "packages/dopaminejs/dist/core.js",
            "import": "*",
            "limit": "6 KB",
            "name": "dopaminejs/core (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/games.js",
            "import": "*",
            "limit": "1.5 KB",
            "name": "dopaminejs/games (ESM)"
        }
    ],
    "engines": {
        "node": ">=20.19"
    }
}
