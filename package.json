{
    "name": "dopaminejs-monorepo",
    "version": "3.7.0",
    "private": true,
    "type": "module",
    "description": "DopamineJS monorepo: gamification for any website",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "test": "node scripts/run-tests.js",
        "test:watch": "npm run test:watch --workspace=dopaminejs",
        "test:ci": "node scripts/run-tests.js",
        "dev": "npm run dev --workspace=dopaminejs",
        "clean": "rm -rf packages/*/dist packages/*/node_modules",
        "typecheck": "tsc -p packages/dopaminejs/tsconfig.json",
        "size": "size-limit",
        "check-zero-deps": "node scripts/check-zero-deps.js",
        "verify": "npm run typecheck && npm run test:ci && DOPAMINE_TEST_TZ=America/Los_Angeles npm run test:ci -- conformance && node scripts/check-versions.js && npm run check-zero-deps && npm run build && node scripts/check-versions.js --dist && node scripts/check-core-import.js && npm run size"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/BaryoDev/dopaminejs.git"
    },
    "keywords": [
        "gamification",
        "engagement",
        "xp",
        "achievements",
        "streaks",
        "confetti",
        "rewards"
    ],
    "author": "BaryoDev",
    "license": "MPL-2.0",
    "devDependencies": {
        "@size-limit/preset-small-lib": "^12.1.0",
        "jsdom": "^28.1.0",
        "size-limit": "^12.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^4.1.12",
        "vue": "^3.5.46"
    },
    "size-limit": [
        {
            "path": "packages/dopaminejs/dist/dopamine.js",
            "import": "*",
            "limit": "16.75 KB",
            "name": "dopaminejs (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/dopamine.cjs",
            "limit": "16.75 KB",
            "name": "dopaminejs (CJS)"
        },
        {
            "path": "packages/dopaminejs/dist/dopamine.global.js",
            "limit": "16.75 KB",
            "name": "dopaminejs (script tag)"
        },
        {
            "path": "packages/dopaminejs/dist/core.js",
            "import": "*",
            "limit": "7.25 KB",
            "name": "dopaminejs/core (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/games.js",
            "import": "*",
            "limit": "1.5 KB",
            "name": "dopaminejs/games (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/celebrate.js",
            "import": "*",
            "limit": "5.02 KB",
            "ignore": ["./certificate.js"],
            "name": "dopaminejs/celebrate (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/certificate.js",
            "import": "*",
            "limit": "4.16 KB",
            "name": "dopaminejs/certificate (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/auto.js",
            "import": "*",
            "limit": "1.8 KB",
            "ignore": ["./celebrate.js", "./certificate.js"],
            "name": "dopaminejs/auto (ESM)"
        },
        {
            "path": "packages/dopaminejs/dist/dopamine.all.global.js",
            "limit": "21.8 KB",
            "name": "dopaminejs (script tag, all)"
        }
    ],
    "engines": {
        "node": ">=20.19"
    }
}
